# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your deployment.
# `.env` is git-ignored; `.env.example` is the committed template.
# ---------------------------------------------------------------------------

# ── Public variables ───────────────────────────────────────────────────────
# Anything prefixed with VITE_ is inlined into the browser bundle at BUILD
# time, so treat these as public. Changing them requires a rebuild.
#
# Absolute origin of the deployment. Used for canonical links, og:url and the
# social preview image URL. No trailing slash. Leave empty for local dev and
# the app falls back to relative URLs.
VITE_PUBLIC_SITE_URL=https://treeviz.example.com

# ── Server variables ───────────────────────────────────────────────────────
# Read at RUNTIME by the Node server, so they can change without a rebuild.
# Never exposed to the browser.
#
# Port the production server listens on.
PORT=3000

# Interface to bind. 0.0.0.0 is required inside Docker.
HOST=0.0.0.0
